// Compresses one level of an RGBA8 image (the ASTC decoder's output) to BC1 or BC3, one 4x4 block
// per invocation, so re-compressed ASTC never round-trips through the CPU. Colour endpoints are
// the block's bounding box, oriented along the colours' covariance and inset by 1/16; each texel
// takes the nearest palette entry. Values are encoded as stored (sRGB data stays sRGB, like the
// CPU path).
//
// The VTX-HLE ASTC stand-ins (nvn_bc_encode.h) also ask for BC4 (red), BC5 (red and alpha into
// red and green), BC1 that never uses the punch-through mode, and refined colour endpoints. The
// emulated path's modes 0 and 1 without REFINE encode as they always did.

#version 460 core
#extension GL_GOOGLE_include_directive : require

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (set = 0, binding = 0, rgba8) uniform readonly image2DArray source;

layout (std430, set = 0, binding = 1) writeonly buffer Output {
    uvec2 blocks[];
};

layout (push_constant) uniform PushConstants {
    uint blocks_x;
    uint blocks_y;
    uint width;
    uint height;
    uint mode; // MODE_* in the low bits, REFINE
    uint out_offset; // in 8-byte units
};

/* the block's texels, and the accessor bcn_encode.glsl's encoders take them through */
vec4 texels[16];

vec4 Texel(int i) {
    return texels[i];
}

#include "bcn_encode.glsl"

void main() {
    const uvec3 id = gl_GlobalInvocationID;
    if (id.x >= blocks_x || id.y >= blocks_y) {
        return;
    }
    const ivec2 base = ivec2(id.xy) * 4;
    const ivec2 last = ivec2(width, height) - 1;
    bool any_transparent = false;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            // Edge blocks repeat the last row/column so padding doesn't widen the endpoints.
            const ivec2 coord = min(base + ivec2(x, y), last);
            texels[y * 4 + x] = imageLoad(source, ivec3(coord, int(id.z)));
            any_transparent = any_transparent || texels[y * 4 + x].a < 0.5;
        }
    }
    const uint block = (id.z * blocks_y + id.y) * blocks_x + id.x;
    const uint kind = mode & MODE_MASK;
    const bool refine = (mode & REFINE) != 0u;
    // The texels inside the level: the refined fit measures its error on them alone.
    const uvec2 inside = uvec2(clamp(ivec2(width, height) - base, ivec2(0), ivec2(4)));
    const uint row = (1u << inside.x) - 1u;
    const uint real = row * (((1u << (4u * inside.y)) - 1u) / 15u); // the row in each nibble
    if (kind == MODE_BC3) {
        blocks[out_offset + block * 2u] = EncodeAlpha();
        blocks[out_offset + block * 2u + 1u] =
            refine ? EncodeColorRefined(real) : EncodeColor(false);
    } else if (kind == MODE_BC4) {
        blocks[out_offset + block] = EncodeRed();
    } else if (kind == MODE_BC5) {
        blocks[out_offset + block * 2u] = EncodeRed();
        blocks[out_offset + block * 2u + 1u] = EncodeAlpha();
    } else {
        const bool punch_through = kind != MODE_BC1_OPAQUE && any_transparent;
        blocks[out_offset + block] = refine && !punch_through ? EncodeColorRefined(real)
                                                              : EncodeColor(punch_through);
    }
}
